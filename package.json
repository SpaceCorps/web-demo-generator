{
  "name": "@spacecorps/web-demo-generator",
  "version": "0.1.0",
  "description": "AI-powered web demo generator: animated UI changes, browser mimicry, and H.264 video recording for patchnotes",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "web-demo-generator": "dist/bin/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "lint:templates": "tsc -p src/templates/tsconfig.json",
    "test": "vitest run"
  },
  "keywords": [
    "claude",
    "demo",
    "video-generator",
    "playwright",
    "h264",
    "patchnotes",
    "browser-automation"
  ],
  "author": "SpaceCorps Technology OÜ",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@fontsource-variable/geist": "^5.2.5",
    "@fontsource-variable/geist-mono": "^5.2.5",
    "playwright": "^1.50.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "happy-dom": "^20.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
